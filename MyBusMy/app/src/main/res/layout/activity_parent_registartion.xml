<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ParentRegistartion"

    android:background="@color/white"
    android:orientation="horizontal"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="7dp"
        android:backgroundTint="#857A139F"
        android:layout_gravity="center"
        android:background="@drawable/customer_edittext">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Sign up"
                    android:textColor="#9CAE1010"
                    android:textSize="30sp"
                    android:textAlignment="center"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/editParentName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Parent Name"
                    android:textColor="@color/black"
                    android:textColorHint="#90000000"
                    android:layout_marginTop="20dp"
                    android:inputType="text" />
                <EditText
                    android:id="@+id/editParentChildID"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:textColorHint="#90000000"
                    android:textColor="@color/black"
                    android:hint="Student Id"
                    android:layout_marginTop="10dp"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/editParentMobile"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:textColorHint="#90000000"
                    android:textColor="@color/black"
                    android:hint="Mobile"
                    android:minEms="10"
                    android:ems="11"
                    android:inputType="number"

                    android:layout_marginTop="10dp"/>

                <EditText
                    android:id="@+id/editParentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:textColorHint="#90000000"
                    android:textColor="@color/black"
                    android:hint="Password"
                    android:inputType="text"
                    android:layout_marginTop="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="left"
                    android:layout_marginTop="20dp"
                    >

                    <Button
                        android:id="@+id/btnParentRegistration"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:backgroundTint="@color/teal_700"
                        android:text="Register"
                        android:textColor="@color/black"
                        android:textSize="25sp"
                        app:cornerRadius="20dp"

                        />

                    <TextView
                        android:id="@+id/textGotoSignin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="20dp"
                        android:text="Do have a account?Sign in"
                        android:textColor="#9CAE1010"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </LinearLayout>


    </androidx.cardview.widget.CardView>

</ScrollView>
