<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddBusTiming"
    android:gravity="center"
    android:background="@drawable/bg_driver"
    android:orientation="horizontal">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp"
        android:background="@drawable/customer_edittext">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Add Bus"
                    android:textColor="@color/black"
                    android:textSize="30sp"
                    android:textAlignment="center"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/editBusNumber"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Bus Number"
                    android:layout_marginTop="20dp"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/editDriverName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Driver Name"
                    android:inputType="text"
                    android:layout_marginTop="10dp"/>

                <EditText
                    android:id="@+id/editDriverPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Password"
                    android:inputType="text"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Route :"
                    android:layout_marginTop="10dp"
                    android:textSize="18sp"
                    android:textStyle="bold"/>


                    <EditText
                        android:id="@+id/editRouteStart"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Begining"
                        android:inputType="text"
                        android:layout_marginTop="5dp"/>
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="To"
                        android:layout_gravity="center"
                        android:textSize="18sp"
                        />
                    <EditText

                        android:id="@+id/editRouteEnd"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint=" Destination"
                        android:inputType="text"
                        android:layout_marginTop="5dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Time :"
                    android:layout_marginTop="10dp"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/editTimingStart"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="5dp"
                        android:hint="Start"
                        android:inputType="text" />
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="To"
                        android:layout_gravity="center"
                        android:textSize="18sp"
                        />
                    <EditText
                        android:id="@+id/editTimingEnd"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="5dp"
                        android:hint="End"
                        android:inputType="text" />



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:orientation="horizontal"
                    android:gravity="left"
                    android:layout_marginTop="20dp"
                    >

                    <Button
                        android:id="@+id/btnSaveBus"
                        android:layout_width="130dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="30dp"
                        android:backgroundTint="@color/black"
                        android:text="Save"
                        android:textSize="25sp"
                        app:cornerRadius="20dp"
                        android:layout_marginRight="20dp"
                        />

                    <Button
                        android:id="@+id/btnBackToPanel"
                        android:layout_width="130dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="30dp"
                        android:backgroundTint="@color/black"
                        android:text="Back"
                        android:textSize="25sp"
                        app:cornerRadius="20dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</ScrollView>
