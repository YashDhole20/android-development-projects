<?xml version="1.0" encoding="UTF-8" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/custom_for_option"
    app:cardCornerRadius="30dp"
    app:cardElevation="20dp"
    android:gravity="center">


<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

        <ImageButton
            android:id="@+id/imageBackToPanelBus"
            android:layout_width="50dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="5dp"
            android:backgroundTint="@color/white"
            android:src="@drawable/baseline_arrow_back_ios_new_24" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:padding="24dp">

            <TextView
                android:id="@+id/textBusTiming"
                android:layout_width="223dp"
                android:layout_height="70dp"
                android:text="Bus Timing\n Management"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="26sp"
                android:layout_marginBottom="5dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAddBus"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="30dp"
                android:backgroundTint="@color/my_primary"
                android:text="Add"
                android:textSize="20sp"
                app:cornerRadius="20dp" />
            <Button
                android:id="@+id/btnViewBus"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="@color/my_primary"
                android:text="View"
                android:textSize="20sp"
                app:cornerRadius="20dp" />
            <Button
                android:id="@+id/btnDeleteBus"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="@color/my_primary"
                android:text="Delete"
                android:textSize="20sp"
                app:cornerRadius="20dp" />

        </LinearLayout>
</LinearLayout>


</LinearLayout >