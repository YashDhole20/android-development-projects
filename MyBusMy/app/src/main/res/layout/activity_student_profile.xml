<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_studentprofile"
    tools:context=".DriverProfile">



    <ImageView
        android:id="@+id/imageStudentLogo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/school_bus"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"/>
    <TextView
        android:id="@+id/textStudentProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Page"
        android:textSize="24sp"
        android:layout_below="@id/imageStudentLogo"
        android:layout_centerHorizontal="true"
        android:textColor="@color/black"
        android:textStyle="bold"
        />
    <TextView
        android:id="@+id/textStudentProfilePhone"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_below="@id/textStudentProfileName"
        android:layout_centerHorizontal="true"
        android:text="phone"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:textSize="20sp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="412dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="15dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnViewEpass"
            android:layout_width="match_parent"
            android:layout_height="69dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:text="View My E-Pass" />



        <Button
            android:id="@+id/btnViewAttendanceStu"
            android:layout_width="match_parent"
            android:layout_height="69dp"
            android:layout_below="@id/btnViewEpass"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:text="View Attendance Student" />

        <Button
            android:id="@+id/btnViewBusDtails"
            android:layout_width="match_parent"
            android:layout_height="69dp"
            android:layout_below="@+id/btnViewAttendanceStu"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="0dp"
            android:text="View Bus" />
        <Button
            android:id="@+id/btnStudentLogout"
            android:layout_width="match_parent"
            android:layout_height="69dp"
            android:layout_below="@+id/btnViewBusDtails"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="0dp"
            android:text="Logout" />
    </RelativeLayout>
</RelativeLayout>
