<?xml version="1.0" encoding="UTF-8" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CD46DA4C"
    android:scrollbars="vertical"
    tools:context=".ShowroomRegisteration">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_gravity="center">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:id="@+id/signupTxt"
            android:textSize="36sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:layout_marginTop="5dp"
            android:textColor="@color/black"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:background="@drawable/customer_edittext">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:padding="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputShowroom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:id="@+id/editShowroom"
                      android:drawablePadding="8dp"
                    android:inputType="text"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="20dp"
                    android:hint="Showroom Name"
                    android:singleLine="true"
                    android:padding="8dp"
                    android:textColor="@color/black"
                    android:textColorHighlight="@color/red"
                    android:layout_marginTop="10dp"/>
                    <TextView
                        android:id="@+id/textShowroom"
                        android:drawableLeft="@drawable/baseline_error_24"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:textColor="@android:color/holo_red_light"
                        android:visibility="gone" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputShowroomUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:id="@+id/editUsername"
                      android:drawablePadding="8dp"
                    android:inputType="text"
                    android:hint="Username"
                    android:singleLine="true"
                    android:padding="8dp"
                    android:textColor="@color/black"
                    android:textColorHighlight="@color/cardview_dark_background"
                    android:layout_marginTop="10dp"/>
                    <TextView
                        android:id="@+id/textUsername"
                        android:drawableLeft="@drawable/baseline_error_24"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:textColor="@android:color/holo_red_light"
                        android:visibility="gone" />
                </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputShowroomEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:id="@+id/editShowEmail"
                      android:drawablePadding="8dp"
                    android:inputType="textEmailAddress"
                    android:hint="E-mail"
                    android:padding="8dp"
                    android:textColor="@color/black"
                    android:textColorHighlight="@color/cardview_dark_background"
                    android:layout_marginTop="10dp"/>
            <TextView
                android:id="@+id/textShowEmail"
                android:layout_width="match_parent"
                android:drawableLeft="@drawable/baseline_error_24"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@android:color/holo_red_light"
                android:visibility="gone" />
        </com.google.android.material.textfield.TextInputLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textInputShowroomMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:id="@+id/editShowMobileNo"
                          android:drawablePadding="8dp"
                        android:inputType="number"
                        android:hint="Mobile Number"
                        android:padding="8dp"
                        android:textColor="@color/black"
                         android:layout_marginStart="5dp" />
                        <TextView
                            android:id="@+id/textShowMobileNo"
                            android:layout_width="match_parent"
                            android:drawableLeft="@drawable/baseline_error_24"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:textColor="@android:color/holo_red_light"
                            android:visibility="gone" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>




                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputShowroomPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:passwordToggleEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:id="@+id/editShowPassword"
                    android:drawablePadding="8dp"
                    android:hint="Password"
                    app:passwordToggleTint="@color/black"
                    android:inputType="textPassword"
                    android:padding="8dp"
                    android:textColor="@color/black"
                    android:textColorHighlight="@color/cardview_dark_background"
                    android:layout_marginTop="10dp"

                    />
                    <TextView
                        android:id="@+id/textShowPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:drawableLeft="@drawable/baseline_error_24"
                        android:textColor="@android:color/holo_red_light"
                        android:visibility="gone" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputShowroomCofirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:passwordToggleEnabled="true"
                     >

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:id="@+id/editShowConfirmPassword"
                      android:drawablePadding="8dp"
                    android:hint="Confirm Password"
                    android:inputType="textPassword"
                    android:padding="8dp"
                    android:textColor="@color/black"
                    android:textColorHighlight="@color/cardview_dark_background"
                    android:layout_marginTop="10dp"/>
                    <TextView
                        android:id="@+id/passwordErrorTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:textColor="@android:color/holo_red_light"
                        android:visibility="gone"
                        android:drawableLeft="@drawable/baseline_error_24"/>
                </com.google.android.material.textfield.TextInputLayout>



                <Button
                    android:id="@+id/btnShowBtnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:text="REGISTER"
                    android:textSize="25sp"
                    android:layout_marginTop="30dp"
                    android:backgroundTint="@color/black"
                    app:cornerRadius="15dp"/>


            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-25dp"
            android:id="@+id/orTxt"
            android:text="OR"
            android:layout_gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/textShowGotoLogin"
            android:text="Do you have an account? Sign in"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>