<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".noovertake">


        <ImageView
            android:layout_width="200dp"
            android:layout_height="160dp"
            android:src="@drawable/noovertaking" />
        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:gravity="center"
            android:textStyle="italic"
            android:text="  Rectangular white sign with a red circle and a black horizontal line. Informs drivers that overtaking is prohibited, promoting safety in areas with limited visibility or potential hazards."/>

</LinearLayout>