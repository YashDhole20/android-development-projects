<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_height="match_parent"
    tools:context=".schoolahead">

    <ImageView
        android:layout_width="200dp"
        android:layout_height="160dp"
        android:src="@drawable/schoolahead" />
    <TextView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:gravity="center"
        android:textStyle="italic"
        android:text=" White, rectangular sign with a green arrow indicating a median or central reservation. Guides drivers to continue straight and follow the median, ensuring proper lane discipline."/>



</LinearLayout>