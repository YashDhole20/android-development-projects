<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_height="match_parent"
    tools:context=".noentry">




        <ImageView
            android:layout_width="200dp"
            android:layout_height="160dp"
            android:src="@drawable/noentry1" />

        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:gravity="center"
            android:textStyle="italic"
            android:text=" Circular red sign with a white horizontal bar and the words No Entry or a prohibitory symbol. Marks the entrance to restricted zones, indicating that entry is prohibited for vehicles. Enhances traffic control and prevents unauthorized access."/>


    </LinearLayout>