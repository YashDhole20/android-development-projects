<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/crop3"
    tools:context=".addpolicies"
    >

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/EditPolicyTitle"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="Policy Title / धोरण शीर्षक"
        android:textStyle="bold"
        android:inputType="text"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginLeft="40dp"/>

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/EditPolicyDescription"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="Policy Description / धोरण वर्णन"
        android:textStyle="bold"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:layout_marginBottom="8dp"
        android:layout_marginLeft="40dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddPolicy"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Add Policy/धोरण जोडा"
        android:textColor="#000000"
        android:padding="12dp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginLeft="40dp"/>

  </LinearLayout>
