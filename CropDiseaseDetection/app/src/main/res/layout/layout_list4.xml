<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/displayname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading..." />
    <TextView
        android:id="@+id/displayaddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/displayname"
        android:text="Loading..." />
    <TextView
        android:id="@+id/displaymobile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/displayaddress"
        android:text="Loading..." />
    <TextView
        android:id="@+id/displayemail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/displaymobile"
        android:text="Loading..." />

    <Button
        android:id="@+id/approve"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/displayemail"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="30dp"
        android:text="Approve" />

    <Button
        android:id="@+id/disapprove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="86dp"
        android:layout_marginLeft="160dp"
        android:text="Disapprove" />

</RelativeLayout>
