<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E5D6B9"
    android:layout_gravity="center"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="350dp"
            android:layout_marginTop="200dp"
            android:layout_height="wrap_content"
            android:textColorHint="#3F2B48"
            android:id="@+id/inputname">

            <EditText
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:id="@+id/editname"
                android:hint="Full Name"
                android:textColor="#3F2B48"
                android:textColorHint="#3F2B48"
                android:inputType="text"
                android:textSize="20sp"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:textColorHint="#3F2B48"
            android:layout_marginTop="10dp"
            android:id="@+id/inputenroll">

            <EditText
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:id="@+id/editenroll"
                android:textColor="#3F2B48"
                android:textColorHint="#3F2B48"
                android:hint="Enrollment Number"
                android:inputType="text"
                android:textSize="20sp"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/dept"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#3F2B48"
            android:textColorHint="#3F2B48"
            android:entries="@array/dept"
            android:spinnerMode="dialog"
            style="@style/Widget.AppCompat.Spinner.Underlined" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/class1"
            android:layout_width="350dp"
            android:layout_marginTop="10dp"
            android:entries="@array/div"
            android:textColor="#3F2B48"
            android:textColorHint="#3F2B48"
            android:layout_height="wrap_content"
            android:spinnerMode="dialog"
            style="@style/Widget.AppCompat.Spinner.Underlined" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColorHint="#3F2B48"
            android:id="@+id/inputpass">

            <EditText
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:id="@+id/editpass"
                android:hint="Password"
                android:textColor="#3F2B48"
                android:textColorHint="#3F2B48"
                android:inputType="textPassword"
                android:textSize="20sp"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <Button
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="Register"
            android:layout_marginTop="10dp"
            android:textColor="#3F2B48"
            android:textColorHint="#3F2B48"
            android:id="@+id/btnregister"
            android:background="#B5C4D3"
            android:textSize="20dp">
        </Button>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login here!!"
            android:id="@+id/txtviewlogin"
            android:textColor="#3F2B48"
            android:textColorHint="#3F2B48"
            android:gravity="center"
            android:textSize="15sp"
            android:layout_marginTop="5sp" />
    </LinearLayout>
</ScrollView>