<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/light"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/optionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        app:layout_constraintTop_toBottomOf="@+id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- TextView and EditText options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TextView Option"
            android:padding="16dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="EditText Option"
            android:padding="16dp"/>
    </LinearLayout>

    <!-- Button Container -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="16dp">

        <!-- Buttons -->
        <Button
            android:id="@+id/firstButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Task"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/material_on_surface_stroke"
            android:drawableLeft="@drawable/baseline_add_task_24"
            android:drawablePadding="8dp"
            android:padding="16dp"
            android:textSize="24sp"
            android:gravity="center_vertical"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Task"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/material_on_surface_stroke"
            android:drawableLeft="@drawable/baseline_preview_24"
            android:drawablePadding="8dp"
            android:padding="16dp"
            android:textSize="24sp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/material_on_surface_stroke"
            android:drawableLeft="@drawable/baseline_delete_24"
            android:drawablePadding="8dp"
            android:padding="16dp"
            android:textSize="24sp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"/>

    </LinearLayout>

</LinearLayout>
